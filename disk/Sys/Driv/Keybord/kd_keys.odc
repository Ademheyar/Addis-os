 $L TAKE LIST $L j $L J END TAKE $L TAKE LIST $L k $L K END TAKE
 $L TAKE LIST $L l $L L END TAKE $L TAKE LIST $L ; $L : END TAKE
 $L TAKE LIST $L LSHIFT $L 0 END TAKE $L TAKE LIST $L ] $L } END TAKE 
 $L TAKE LIST $L z $L Z END TAKE $L TAKE LIST $L x $L X END TAKE 
 $L TAKE LIST $L c $L C END TAKE $L TAKE LIST $L v $L V END TAKE 
 $L TAKE LIST $L m $L M END TAKE $L TAKE LIST $L $L < END TAKE 
 $L TAKE LIST $L . $L > END TAKE $L TAKE LIST $L ; $L : END TAKE 
 $L TAKE LIST $L RSHIFT $L 0 END TAKE $L TAKE LIST $L 0 $L 0 END TAKE 
 $L TAKE LIST $L ALT $L 0 END TAKE $L TAKE LIST $L  $L  END TAKE 
 $L TAKE LIST $L 0 $L 0 END TAKE $L TAKE LIST $L KEY_F1 $L KEY_F1 END TAKE
 $L TAKE LIST $L KEY_F2 $L KEY_F2 END TAKE $L TAKE LIST $L KEY_F3 $L KEY_F3 END TAKE
 $L TAKE LIST $L KEY_F4 $L KEY_F4 END TAKE $L TAKE LIST $L KEY_F5 $L KEY_F5 END TAKE
 $L TAKE LIST $L KEY_F6 $L KEY_F6 END TAKE $L TAKE LIST $L KEY_F7 $L KEY_F7 END TAKE
 $L TAKE LIST $L KEY_F8 $L KEY_F8 END TAKE $L TAKE LIST $L KEY_F9 $L KEY_F9 END TAKE
 $L TAKE LIST $L KEY_F10 $L KEY_F10 END TAKE $L TAKE LIST $L 0 $L 0 END TAKE
 $L TAKE LIST $L 0 $L 0 END TAKE $L TAKE LIST $L KEY_HOME $L 7 END TAKE
 $L TAKE LIST $L KEY_UP $L 8 END TAKE $L TAKE LIST $L KEY_PGUP $L 9 END TAKE
 $L TAKE LIST $L - $L 0 END TAKE $L TAKE LIST $L KEY_LEFT $L 4 END TAKE
 $L TAKE LIST $L 5 $L 0 END TAKE $L TAKE LIST $L KEY_RIGHT $L 6 END TAKE
 $L TAKE LIST $L + $L 0 END TAKE $L TAKE LIST $L KEY_END $L 1 END TAKE
 $L TAKE LIST $L KEY_DOWN $L 2 END TAKE $L TAKE LIST $L KEY_PGDN $L 3 END TAKE
 $L TAKE LIST $L KEY_INS $L 0 END TAKE $L TAKE LIST $L KEY_DEL $L KEY_DEL END TAKE
 $L TAKE LIST $L KEY_F11 $L KEY_F11 END TAKE $L TAKE LIST $L KEY_F12 $L KEY_F12 END TAKE
 $L TAKE LIST $L \\ $L | END TAKE $L TAKE LIST $L \n $L \n END TAKE
 $L TAKE LIST $L CTRL $L 0 END TAKE $L TAKE LIST $L / $L 0 END TAKE
 $L TAKE LIST $L SYSRQ $L PSCREEN END TAKE $L TAKE LIST $L ALT $L 0 END TAKE
 $L TAKE LIST $L KEY_HOME $L 0 END TAKE $L TAKE LIST $L KEY_UP $L 0 END TAKE
 $L TAKE LIST $L KEY_PGUP $L 0 END TAKE $L TAKE LIST $L KEY_LEFT $L 0 END TAKE
 $L TAKE LIST $L KEY_RIGHT $L 0 END TAKE $L TAKE LIST $L KEY_END $L 0 END TAKE
 $L TAKE LIST $L KEY_DOWN $L 0 END TAKE $L TAKE LIST $L KEY_PGDN $L 0 END TAKE
