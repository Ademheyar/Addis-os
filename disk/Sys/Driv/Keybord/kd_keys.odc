INCLUDE TAKE PATH /Sys/Driv/Keybord/kd_keys.odc END TAKE

CREATE FANCTION TAKE NAME convert END TAKE WITH CREATE uint32_t code END WITH 
DO
  CREATE uint8_t TAKE NAME k_shift END TAKE
  SET TAKE NUMBER 0 END TAKE TO k_shift VALUE
  CREATE uint8_t TAKE NAME k_num END TAKE
END DO

CREATE FANCTION WITH CREATE INTEGUR TAKE NAME code END TAKE END WITH TAKE NAME keyboard_callback END TAKE DO
  CREATE INTEGUR TAKE NAME scancode END TAKE
  CREATE INTEGUR TAKE NAME code END TAKE
  CREATE INTEGUR TAKE NAME packet END TAKE
  
  SET TAKE NUMBER 0 END TAKE TO packet VALUE
  CHANGE scancode VALUE TO INPUT TAKE BINARY 0x60 END TAKE

  COMMENT 
  KEYBOARD_DATA_PORT 
  message_t msg 
  END COMMENT
  
END DO

CREATE FANCTION WITH  END WITH TAKE NAME MAIN END TAKE DO
  REGISTER_DRIVER TAKE BINARY 0x01 END TAKE
  WITH READ TAKE NAME keyboard_callback END TAKE END WITH
  ENABLE_DRIVER TAKE BINARY 0x01 END TAKE
END DO

READ TAKE NAME MAIN END TAKE WITH END WITH

CREATE LIST TAKE NAME keymap END TAKE
SET TAKE LIST 
 $L TAKE LIST $L 0 $L 0 END TAKE $L TAKE LIST $L ESC $L 0 END TAKE
 $L TAKE LIST $L 1 $L ! END TAKE $L TAKE LIST $L 2 $L @ END TAKE
