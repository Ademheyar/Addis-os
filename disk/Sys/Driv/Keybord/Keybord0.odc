INCLUDE TAKE PATH /Sys/Driv/Keybord/kd_keys.odc END TAKE

CREATE FANCTION 
TAKE NAME convert END TAKE 
WITH CREATE uint32_t code END WITH 
DO
  CREATE uint8_t TAKE NAME k_shift END TAKE
  SET TAKE NUMBER 0 END TAKE TO k_shift VALUE
  CREATE uint8_t TAKE NAME k_num END TAKE
  SET TAKE NUMBER 0 END TAKE TO k_num VALUE
  CREATE uint8_t TAKE NAME k_caps END TAKE
  SET TAKE NUMBER 0 END TAKE TO k_caps VALUE
  CREATE uint8_t TAKE NAME k_scroll END TAKE
  SET TAKE NUMBER 0 END TAKE TO k_scroll VALUE
  CREATE uint32_t TAKE NAME key END TAKE
  SET TAKE NUMBER 0 END TAKE TO key VALUE
  CREATE uint8_t TAKE NAME leds END TAKE
  SET TAKE BOOL false END TAKE TO leds VALUE
  CREATE uint8_t TAKE NAME i END TAKE
  IF GET code VALUE IS GRATER THAN OR EQUAL TO GET KEYMAP_SIZE DO
  	RETURN 0
  END DO
  IF code AND KEY_RELEASED DO
  	COMMENT CHANGE code &= 0x7F END COMMENT
		SWITCH code VALUE
  	CASE LSHIFT OR RSHIFT DO
			CHANGE k_shift TO TAKE NUMBER 0 END TAKE
			RETURN WITH TAKE NUMBER 0 END TAKE END WITH
  	END DO
		CASE ALT DO
			COMMENT CHANGE k_alt TO TAKE NUMBER 0 END TAKE END COMMENT
		  RETURN WITH TAKE NUMBER 0 END TAKE END WITH
    END DO
		CASE CTRL DO
			COMMENT CHANGE k_ctrl TO TAKE NUMBER 0 END TAKE END COMMENT
    END DO
    IF k_shift VALUE DO
      CHANGE key TO GET keymap INDEX code INDEX 1
    END DO
    ELSE DO
      CHANGE key TO GET keymap INDEX code INDEX 0
    END DO
	END DO

	SWITCH code VALUE
	CASE KEY_NUM_LOCK DO
		COMMENT CHANGE k_num = ! k_num END COMMENT
		CHANGE leds TO true
	END DO
	CASE KEY_SCROLL_LOCK DO
		COMMENT CHANGE k_scroll = ! k_scroll END COMMENT
		CHANGE leds TO TRUE
	END DO
	CASE KEY_CAPS_LOCK DO
		COMMENT CHANGE k_caps = ! k_caps END COMMENT
		CHANGE leds TO TRUE
	END DO
	CASE LSHIFT OR RSHIFT DO
		CHANGE k_shift TO TAKE NUMBER 1 END TAKE
		RETURN WITH TAKE NUMBER 0 END TAKE END WITH
  END DO
	CASE ALT DO
		COMMENT CHANGE k_alt TO TAKE NUMBER 1 END TAKE END COMMENT
		RETURN WITH TAKE NUMBER 0 END TAKE END WITH
  END DO
	CASE CTRL DO
	  COMMENT CHANGE k_ctrl TO TAKE NUMBER 1 END TAKE END COMMENT
  END DO
	default DO
		IF k_shift DO
			CHANGE key TO GET keymap INDEX code INDEX 1
		END DO
		ELSE DO
			CHANGE key TO GET keymap INDEX code INDEX 0
		END DO
	END DO

	IF leds DO
		outp 0x60 0xED
		CHANGE i TO TAKE NUMBER 0 END TAKE
		IF k_scroll DO
			COMMENT CHANGE i |= 1 END COMMENT
		END DO
		IF k_num DO
			COMMENT CHANGE i |= 2 END COMMENT
		END DO
		IF k_caps DO
			COMMENT CHANGE i |= 4 END COMMENT
		END DO
		outp 0x60 i
		RETURN WITH TAKE NUMBER 0 END TAKE END WITH
	END DO
	RETURN WITH key VALUE END WITH
END DO







CREATE FANCTION WITH CREATE INTEGUR TAKE NAME code END TAKE END WITH TAKE NAME keyboard_callback END TAKE DO
  CREATE INTEGUR TAKE NAME scancode END TAKE
  CREATE INTEGUR TAKE NAME code END TAKE
  CREATE INTEGUR TAKE NAME packet END TAKE
  
  SET TAKE NUMBER 0 END TAKE TO packet VALUE
  CHANGE scancode VALUE TO INPUT TAKE BINARY 0x60 END TAKE

  COMMENT KEYBOARD_DATA_PORT END COMMENT
  COMMENT message_t msg END COMMENT

  CHANGE code VALUE TO
  READ
    TAKE NAME convert END TAKE
    WITH
      CHANGE code VALUE TO scancode VALUE
    END WITH

  IF code VALUE IS TRUE DO
    IF scancode VALUE AND KEY_RELEASED VALUE IS TRUE DO
      SET packet TO TAKE NUMBER 0 END TAKE
      COMMENT IF released reset old  in CASE IF user taps multiple times END COMMENT
      SET msg.message TO MESSAGE_KEY_RELEASE
    END DO
    ELSE DO
      SET packet TO TAKE NUMBER 1 END TAKE
      SET msg.message TO MESSAGE_KEY_PRESS
    END DO
    COMMENT packet <<= 8 END COMMENT
    COMMENT packet |= code END COMMENT
   END DO

  COMMENT msg.key = code END COMMENT

  IF msg.message IS NOT EQUAL TO old_msg.message OR msg.key IS NOT EQUAL TO old_msg.key DO
  	COMMENT window_m_add_message_to_focused &msg END COMMENT
  	SET old_msg TO msg
  END DO
END DO








CREATE FANCTION WITH  END WITH TAKE NAME MAIN END TAKE DO
  REGISTER_DRIVER TAKE BINARY 0x01 END TAKE
  WITH READ TAKE NAME keyboard_callback END TAKE END WITH
  ENABLE_DRIVER TAKE BINARY 0x01 END TAKE
END DO

READ TAKE NAME MAIN END TAKE WITH END WITH