CREATE FANCTION
TAKE NAME fanc0 END TAKE
WITH
  CREATE STRING TAKE NAME msg0 END TAKE
END WITH
DO
  RETURN GET msg0 VALUE
END DO


CREATE FANCTION
TAKE NAME fanc1 END TAKE
WITH
  CREATE STRING TAKE NAME msg1 END TAKE
END WITH
DO
  CREATE STRING TAKE NAME packet END TAKE AND TAKE NAME gotv END TAKE
  CHANGE packet VALUE TO READ TAKE NAME fanc0 END TAKE WITH GET msg1 VALUE END WITH
  SET GET packet VALUE TO gotv VALUE
END DO


CREATE FANCTION
TAKE NAME MAIN END TAKE
WITH
CREATE STRING TAKE NAME A END TAKE
CREATE INTEGUR TAKE NAME B END TAKE
END WITH
DO
READ TAKE NAME fanc1 END TAKE WITH TAKE STRING YOU GOT ME END TAKE END WITH
END DO
