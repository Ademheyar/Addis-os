CREATE FANCTION TAKE NAME MAIN END TAKE WITH END WITH DO
  CREATE STRING TAKE NAME a END TAKE
  CREATE STRING TAKE NAME b END TAKE
  CREATE NUMBER TAKE NAME c END TAKE
  CREATE NUMBER TAKE NAME d END TAKE
  CHANGE d VALUE TO TAKE NUMBER 2 END TAKE
  CHANGE a VALUE TO TAKE NUMBER YOU GOT ME END TAKE
  CHANGE c VALUE TO TAKE NUMBER 5 END TAKE
  WHILE GET c VALUE IS EQUAL TO TAKE NUMBER 5 END TAKE DO
    IF a IS EQUAL TO b DO

    END DO
    ELSE IF b IS EQUAL TO TAKE STRING none END TAKE DO
      CHANGE b VALUE TO TAKE NUMBER YOU GOT ME END TAKE
    END DO
    ELSE DO
      SWITCH GET d VALUE
      CASE TAKE NUMBER 1 END TAKE DO
        CHANGE b VALUE TO TAKE STRING none END TAKE
        CHANGE d VALUE TO TAKE NUMBER 4 END TAKE
      END DO

      CASE TAKE NUMBER 2 END TAKE DO
        CHANGE b VALUE TO TAKE STRING non END TAKE
        CHANGE d VALUE TO TAKE NUMBER 1 END TAKE
      END DO
    END DO
  END DO
END DO
