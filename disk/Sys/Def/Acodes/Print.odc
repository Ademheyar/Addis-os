DEFINE Print
	DEFINE string OR taxt
		GET
		Create String TAKE NAME str END TAKE
		Create Integur TAKE NAME x END TAKE AND TAKE NAME y END TAKE
		Print string TAKE STRING HELLO WORLD END TAKE
		SET GET TABLE VALUE TO GET str
		SET GET SCREEN X VALUE TO GET x
		SET GET SCREEN Y VALUE TO GET y
		FOR INTEGUR i IN str ARRIYA DO
			IF GET str ARRIYA i VALUE IS EQUAL TO TAKE CHARACTER \n END TAKE DO
				Add TAKE INTEGUR 8 END TAKE TO GET y
			END DO

			IF GET SCREEN W VALUE IS EQUAL TO GET x VALUE DO
				SET TAKE INTEGUR 0 END TAKE TO GET x
			END DO
			
			DRAW CHARACTER GET str ARRIYA i VALUE
			GET x VALUE GET y VALUE 
			TAKE COLOR WHITE END TAKE TAKE COLOR BLACK END TAKE 
			GET SCREEN
			
			Add TAKE INTEGUR 8 END TAKE TO GET x
		END DO
		SET GET y VALUE TO GET SCREEN Y
		SET GET x VALUE TO GET SCREEN X
	END DEFINE
END DEFINE