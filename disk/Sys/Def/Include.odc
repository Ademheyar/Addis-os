CoMmAnD->Variables->New["INCLUDE"]->Extern
INCLUDE->Do {
	CoMmAnD->Variables->New["INCLUDEIF"]->Extern
	INCLUDEIF->If["CoMmAnD->Parent->Scan CoMmAnD->Variables->Path"]
	{
		CoMmAnD->Files->Load CoMmAnD->Variables->Get CoMmAnD->Variables->Path
		CoMmAnD->Parent->Tasks->Know CoMmAnD->Variables->Focused
	}
	INCLUDEIF->Else
	{
		CoMmAnD->Files->Load CoMmAnD->Variables->Get CoMmAnD->Variable->Path
		CoMmAnD->Parent->Tasks->Know INCLUDEIF
	}
	INCLUDEIF->Execute
}