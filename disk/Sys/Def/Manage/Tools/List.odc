DEFINE List
	DEFINE new
		GET AS TAKE NAME name END TAKE
		GET AS TAKE NAME parent END TAKE
    TABLE 1 NEW LOCALE AS name AND TAKE NAME new_list END TAKE
    Set TAKE X 0 END TAKE OR TAKE Y 0 END TAKE AND TAKE WIDTH 100 END TAKE AND TAKE HEIGHT 100 END TAKE To new_list
		Set TAKE SHAPE RECTANGLE END TAKE To new_list
    
		Add TAKE NAME Selected END TAKE To TABLE 1 NEW LOCALE
		Add Selected To new_list
		Add new_list To parent

	END DEFINE

	DEFINE text
		GET AS TAKE NAME value END TAKE
		GET AS TAKE NAME parent END TAKE
    TABLE 1 NEW LOCALE AS TAKE NAME new_text END TAKE

		Add value To new_text
		Add new_text To parent

		Set TAKE FRONT_COLOR BLACK END TAKE OR TAKE BACK_COLOR WHITE END TAKE To new_text
	END DEFINE
END DEFINE





maindef=/Sys/Def/Acodes/Do/Do.odc
maindef=/Sys/Def/Acodes/Selectionlogics/If/If.odc
maindef=/Sys/Def/Acodes/Selectionlogics/Else/Else.odc
maindef=/Sys/Def/Acodes/Take/Take.odc
maindef=/Sys/Def/Acodes/Print/Print.odc

COMMENT VVVVVVVVVVVVVVVVVVVVVVVVVVVVVV 0 VVVVVVVVVVVVVVVVVVVVVVVVVVVVVV END COMMENT

COMMENT VVVVVVVVVVVVVVVVVVVVVVVVVVVVVV 1 VVVVVVVVVVVVVVVVVVVVVVVVVVVVVV END COMMENT
CREATE FANCTION
TAKE NAME no60fanc END TAKE
WITH
  CREATE STRING TAKE NAME msg END TAKE
END WITH
DO
  RETURN msg VALUE
END DO
COMMENT ^^^^^^^^^^^^^^^^^^^^^^^^^^^^ 1 ^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^  END COMMENT

COMMENT VVVVVVVVVVVVVVVVVVVVVVVVVVVVVV 1 VVVVVVVVVVVVVVVVVVVVVVVVVVVVVV END COMMENT
CREATE FANCTION
TAKE NAME no50fanc END TAKE
WITH
  CREATE STRING TAKE NAME test0 END TAKE
END WITH
DO
  CREATE STRING TAKE NAME test END TAKE
  CHANGE test VALUE TO READ TAKE NAME no60fanc END TAKE WITH test0 VALUE END WITH
END DO
COMMENT ^^^^^^^^^^^^^^^^^^^^^^^^^^^^ 1 ^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^  END COMMENT

